<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Instrument overlay (crosshair, compass, tilt) -->
    <com.xera.ptzcam.HudView
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Tracking box, selection box and tap-to-aim marker (non-interactive) -->
    <com.xera.ptzcam.TrackOverlayView
        android:id="@+id/trackOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Invisible swipe / pinch / tap layer -->
    <com.xera.ptzcam.SwipePadView
        android:id="@+id/swipePad"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pulsing red frame while recording -->
    <View
        android:id="@+id/recFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rec_frame"
        android:visibility="gone" />

    <!-- Photo shutter flash -->
    <View
        android:id="@+id/flashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone" />

    <!-- ===== Top row: status strip (scrolls on narrow screens) + tools ===== -->
    <LinearLayout
        android:id="@+id/topRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/statusStrip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <View
                    android:id="@+id/linkDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/linkText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:letterSpacing="0.1"
                    android:text="OFFLINE"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/modelText"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/glass_pill"
                    android:fontFamily="@font/rajdhani_bold"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="SHJ-TW10"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/bitrateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="— kbps"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/recPill"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/rec_pill"
                    android:fontFamily="@font/jetbrains_mono"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="● REC 00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tempText"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/badge_bg"
                    android:fontFamily="@font/jetbrains_mono"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/nightBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/badge_bg"
                    android:fontFamily="@font/rajdhani_bold"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="IR ON"
                    android:textColor="@color/accent"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/batteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="--%"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/clockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="00:00:00"
                    android:textColor="@color/text_main"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/modeChip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/chip_active"
            android:drawablePadding="6dp"
            android:fontFamily="@font/rajdhani_bold"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="PATROL"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/round_glass"
            android:contentDescription="Gallery"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gallery" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/round_glass"
            android:contentDescription="Settings"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tune" />
    </LinearLayout>

    <!-- ===== Zoom rocker (left) ===== -->
    <LinearLayout
        android:id="@+id/zoomGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/zoomText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/glass_pill"
            android:fontFamily="@font/jetbrains_mono"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="1.0×"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <com.xera.ptzcam.ZoomRockerView
            android:id="@+id/zoomRocker"
            android:layout_width="46dp"
            android:layout_height="190dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.15"
            android:text="ZOOM"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ===== Glass control rail (right) ===== -->
    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="66dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:padding="5dp" />

    <!-- ===== Gimbal debug line (Settings → Show gimbal debug) ===== -->
    <TextView
        android:id="@+id/debugText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="64dp"
        android:background="@drawable/glass_pill"
        android:fontFamily="@font/jetbrains_mono"
        android:maxLines="4"
        android:maxWidth="460dp"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:textColor="#B3FFFFFF"
        android:textSize="9sp"
        android:visibility="gone" />

    <!-- ===== HUD message strip ===== -->
    <TextView
        android:id="@+id/hudMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:alpha="0"
        android:background="@drawable/glass_pill"
        android:fontFamily="@font/rajdhani_semibold"
        android:maxWidth="520dp"
        android:paddingStart="18dp"
        android:paddingTop="7dp"
        android:paddingEnd="18dp"
        android:paddingBottom="7dp"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <!-- ===== Connect screen ===== -->
    <FrameLayout
        android:id="@+id/connectOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2070B14"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/connectLogo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="XeraCAM"
                android:src="@mipmap/ic_launcher_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-14dp"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.25"
                android:text="XERACAM"
                android:textColor="@color/text_main"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_semibold"
                android:letterSpacing="0.35"
                android:text="PTZ CAMERA CONTROL"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/glass_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <include android:id="@+id/stepLink" layout="@layout/connect_step" />
                <include android:id="@+id/stepOnvif" layout="@layout/connect_step" />
                <include android:id="@+id/stepVideo" layout="@layout/connect_step" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/connectSettings"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:fontFamily="@font/rajdhani_bold"
                    android:stateListAnimator="@null"
                    android:text="SETTINGS"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/connectSkip"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:fontFamily="@font/rajdhani_bold"
                    android:stateListAnimator="@null"
                    android:text="SKIP"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <!-- ===== Preset dial overlay ===== -->
    <FrameLayout
        android:id="@+id/presetOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.3"
                android:text="PRESETS"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <com.xera.ptzcam.PresetDialView
                android:id="@+id/presetDial"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_semibold"
                android:letterSpacing="0.12"
                android:text="TAP = GO   ·   HOLD = SAVE   ·   TAP OUTSIDE = CLOSE"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/patrolBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="5dp"
                android:paddingEnd="16dp"
                android:paddingBottom="5dp">

                <Button
                    android:id="@+id/btnPatrol"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_primary_pill"
                    android:drawableStart="@drawable/ic_patrol_small"
                    android:drawablePadding="6dp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:letterSpacing="0.08"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null"
                    android:text="START PATROL"
                    android:textColor="#0B111C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/patrolSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:maxWidth="260dp"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Settings side sheet ===== -->
    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/glass_sheet"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/rajdhani_bold"
                    android:letterSpacing="0.25"
                    android:text="SETTINGS"
                    android:textColor="@color/text_main"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/settingsClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/rail_item_bg"
                    android:contentDescription="Close"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/glass_stroke" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical">

                <LinearLayout
                    android:id="@+id/settingsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="12dp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <Button
                    android:id="@+id/settingsSave"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/btn_primary"
                    android:fontFamily="@font/rajdhani_bold"
                    android:letterSpacing="0.08"
                    android:stateListAnimator="@null"
                    android:text="SAVE"
                    android:textColor="#0B111C"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
