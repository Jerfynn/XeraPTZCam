<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Swipe / pinch layer over the video -->
    <com.xera.ptzcam.SwipePadView
        android:id="@+id/swipePad"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- White flash for photo capture (not clickable, touches pass through) -->
    <View
        android:id="@+id/flashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone" />

    <!-- Top status bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:text="XeraCAM"
            android:textColor="#4FC3F7"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Connecting…"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/recText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:text="● REC 00:00"
            android:textColor="#FF5252"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/CamButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="0dp"
            android:text="⚙"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- On-screen joystick: pan / tilt -->
    <com.xera.ptzcam.JoystickView
        android:id="@+id/joystick"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp" />

    <!-- Preset panel: tap = go, long-press = save -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/panel_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRESETS · tap = go · hold = save"
            android:textColor="#BBFFFFFF"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/presetFront" style="@style/PresetButton" android:text="FRONT" />
            <Button android:id="@+id/presetLeft" style="@style/PresetButton" android:text="LEFT" />
            <Button android:id="@+id/presetUp" style="@style/PresetButton" android:text="UP" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/presetRear" style="@style/PresetButton" android:text="REAR" />
            <Button android:id="@+id/presetRight" style="@style/PresetButton" android:text="RIGHT" />
            <Button android:id="@+id/presetDown" style="@style/PresetButton" android:text="DOWN" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right-hand controls: 2 columns x 3 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button android:id="@+id/btnZoomIn" style="@style/CamButton" android:text="ZOOM\n+" />
            <Button android:id="@+id/btnZoomOut" style="@style/CamButton" android:text="ZOOM\n−" />
            <Button android:id="@+id/btnNight" style="@style/CamButton" android:text="NIGHT\nOFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button android:id="@+id/btnPhoto" style="@style/CamButton" android:text="PHOTO" />
            <Button
                android:id="@+id/btnRecord"
                style="@style/CamButton"
                android:background="@drawable/btn_rec"
                android:text="REC" />
            <Button android:id="@+id/btnHome" style="@style/CamButton" android:text="HOME" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
