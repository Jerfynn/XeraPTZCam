<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="100dp" /><solid android:color="#5529B6F6" />
            <stroke android:width="1dp" android:color="@color/accent" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="100dp" /><solid android:color="#D90B111C" />
            <stroke android:width="1.5dp" android:color="@color/accent" /></shape>
    </item>
</selector>
